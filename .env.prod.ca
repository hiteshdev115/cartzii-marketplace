# Cartzii storefront — PRODUCTION CANADA. Deployed to www.cartzii.ca.
#
# COMMITTED ON PURPOSE. This is the file the production CA slot runs: the
# deploy does `git reset --hard`, so editing it here and pushing IS how
# production config changes. Editing it on the server does nothing.
#
# Values are inlined at BUILD time by `npm run build:prod:ca`, so a change
# needs a rebuild (which the deploy does), not a pm2 restart.
#
# NOT YET LIVE. Production deploys are disabled and no production slot exists,
# so nothing has ever read this file. The placeholders must be filled first.

# ONE API serves both countries. There is no api.cartzii.ca: the country
# travels on each request as X-Portal-Locale, not in the hostname. The QA
# equivalent of this line pointed at a .ca host that merely 308-redirected
# here, costing a round trip per image.
NEXT_PUBLIC_API_URL=https://api.cartzii.com
NEXT_PUBLIC_IMAGE_CDN_URL=https://api.cartzii.com/assets/upload/productImages

# This storefront's own origin, for canonical tags.
#
# NOTE: www vs bare is still unsettled — nginx's www-redirect.conf 301s www to
# bare while the shipped canonical tags name www. Resolve before launch; this
# line, the two SITE_URL lines below and the seller portal's
# NEXT_PUBLIC_MARKETPLACE_HOST must all agree with whichever wins.
NEXT_PUBLIC_BASE_URL=https://www.cartzii.ca

# MUST match GUEST_API_TOKEN in the API's .env.prod, or every guest read 401s.
# Deliberately not filled in: this file is in git, and a production token
# committed on day one leaks forever. Generate at launch, set on the server.
NEXT_PUBLIC_GUEST_API_TOKEN=<REPLACE AT LAUNCH — must match the API's GUEST_API_TOKEN>

# Stripe LIVE publishable key. Safe in the browser, but still left blank so
# that a half-configured launch fails at checkout rather than silently taking
# card details against the wrong account.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<REPLACE AT LAUNCH — pk_live_...>

# Address autocomplete at checkout. OPTIONAL; falls back to manual entry.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Country this build serves. Inlined at build time, so each slot builds its own.
NEXT_PUBLIC_COUNTRY=ca

# Both storefront origins, for hreflang across the two domains. Each build
# needs BOTH — hreflang has to point at the other country's site, which is the
# one thing that cannot be expressed as a path now the domains are separate.
NEXT_PUBLIC_SITE_URL_CA=https://www.cartzii.ca
NEXT_PUBLIC_SITE_URL_US=https://www.cartzii.com
