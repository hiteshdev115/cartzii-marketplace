{
  "name": "cartzii-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:qa": "dotenv -e .env.qa -- next dev",
    "build": "next build",
    "build:prod:ca": "dotenv -e .env.prod.ca -- next build && npm run standalone:assets",
    "build:prod:us": "dotenv -e .env.prod.us -- next build && npm run standalone:assets",
    "build:qa:ca": "dotenv -e .env.qa.ca -- next build && npm run standalone:assets",
    "build:qa:us": "dotenv -e .env.qa.us -- next build && npm run standalone:assets",
    "standalone:assets": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "build:qa": "dotenv -e .env.qa -- next build",
    "build:production": "dotenv -e .env.production -- next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mapbox/search-js-react": "^1.5.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@stripe/react-stripe-js": "^2.0.0",
    "@stripe/stripe-js": "^4.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-intl": "^4.9.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "swiper": "^12.1.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
