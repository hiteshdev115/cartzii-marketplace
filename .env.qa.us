# Cartzii storefront — QA US. Values are inlined at build time by
# npm run build:qa:us; changing them needs a rebuild, not a pm2 restart.
NEXT_PUBLIC_API_URL=https://qa-api.cartzii.com
NEXT_PUBLIC_BASE_URL=https://qa.cartzii.com
NEXT_PUBLIC_IMAGE_CDN_URL=https://qa-api.cartzii.com/assets/upload/productImages
NEXT_PUBLIC_GUEST_API_TOKEN=guest_cartzii_staging_secure_d9f2c7a4e8b1d5f3c6a2e4b7d9f1c8a3
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51MRKKWFz4dklOGiSawwRdX66UDrsOERGpgPVSfPL7PqpdRYie58ZyQXF3YqhjTXs9ZT4KX7tU8iqi3ThZFfsT23U00EuOpSJF9
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Country this build serves. Inlined at build time, so each slot builds its own.
NEXT_PUBLIC_COUNTRY=us

# Both storefront origins, for hreflang across the two domains.
NEXT_PUBLIC_SITE_URL_CA=https://qa.cartzii.ca
NEXT_PUBLIC_SITE_URL_US=https://qa.cartzii.com
