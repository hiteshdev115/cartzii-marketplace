yarn-error.log*
.pnpm-debug.log*

# env files
#
# Nothing with a secret is tracked: ignore every env file, then allow back
# only the templates. This repo builds FOUR deployments from one codebase —
# .env.qa.ca, .env.qa.us, .env.prod.ca, .env.prod.us — and each real file is
# created once on its server slot, never committed.
#
# Four of them WERE tracked before 2026-09-21. Git history keeps their
# contents, so any credential that appeared in them is burned and needs
# rotating before launch.
#
# Local development uses .env.local (see .env.local.example). Next loads
# .env.local and .env.production during ANY build, so a stray .env.production
# would silently beat the per-slot file on a plain `next build` — which is why
# the ignore is a blanket one rather than a list.
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
