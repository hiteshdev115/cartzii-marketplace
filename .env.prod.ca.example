# Cartzii storefront — PROD CA
#
# Template for `.env.prod.ca`. Copy to that name on the server and fill
# in every <...> value; the real file is gitignored.
#
#   /srv/cartzii/prod/ca/marketplace    port 4001    https://cartzii.ca
#
# Read by `npm run build:prod:ca` and by ecosystem.config.js for the
# `cartzii-prod-ca-marketplace` pm2 process.
#
# Every value here is NEXT_PUBLIC_*, inlined into the bundle at build time.
# Changing any of them requires a rebuild, not a pm2 restart.

# API this storefront calls. Country-matched: the CA storefront must
# never talk to the US API, or shoppers are offered the other country's
# listings and shipping rates.
NEXT_PUBLIC_API_URL=https://api.cartzii.ca

# This storefront's own public origin. Canonical tags, hreflang alternates,
# sitemap.xml and robots.txt are all built from it. UNSET IS NOT SAFE: the code
# falls back to https://cartzii.com, so a Canadian deployment would advertise the
# production US storefront as the canonical home of every page it serves.
NEXT_PUBLIC_BASE_URL=https://cartzii.ca

# Which country this build serves. The country is no longer in the URL path —
# cartzii.ca is Canada and cartzii.com is the United States — so this is how
# the app knows which one it is. NEXT_PUBLIC_, therefore inlined at BUILD time:
# a build made for one country cannot be repointed at the other by changing
# the environment afterwards.
NEXT_PUBLIC_COUNTRY=ca

# Both storefront origins, for hreflang. Each page declares its counterpart on
# the other domain; without these the two country sites compete with each other
# in search instead of being read as regional variants of the same page.
NEXT_PUBLIC_SITE_URL_CA=https://cartzii.ca
NEXT_PUBLIC_SITE_URL_US=https://cartzii.com

# Where product images are served from. The fallback in the code is the old
# staging host, which is being retired — leaving this unset breaks every
# product thumbnail once that hostname goes away.
NEXT_PUBLIC_IMAGE_CDN_URL=https://api.cartzii.ca/assets/upload/productImages

# Must equal GUEST_API_TOKEN in the matching API deployment's env file
# (.env.prod.ca in cartzii-api-server). Used for anonymous browsing.
NEXT_PUBLIC_GUEST_API_TOKEN=<generate — must match the API's GUEST_API_TOKEN>

# Publishable key of the Stripe platform account for CA. Must pair with the STRIPE_SECRET_KEY in the matching API deployment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live...>

# Mapbox address autocomplete at checkout. Ships to the browser, so restrict it
# by URL to cartzii.ca in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=<pk....>