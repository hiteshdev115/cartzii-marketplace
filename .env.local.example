# ---------------------------------------------------------------------------
# Cartzii Marketplace — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values before running the app.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Base URL for the Cartzii API server (Phase 1).
# Examples:
#   https://api.cartzii.com           (production)
#   https://staging-api.cartzii.com   (staging — default fallback)
#   http://localhost:4000             (local dev)
NEXT_PUBLIC_API_URL=https://staging-api.cartzii.com

# Optional guest token sent as `x-guest-token` header on unauthenticated
# API requests (cart, checkout). Obtain from the API team.
NEXT_PUBLIC_GUEST_API_TOKEN=

# ---------------------------------------------------------------------------
# CDN / Assets
# ---------------------------------------------------------------------------

# CDN base for product images (bare filenames returned by the API are
# prefixed with this URL).
NEXT_PUBLIC_IMAGE_CDN_URL=https://staging-api.cartzii.com/assets/upload/productImages

# ---------------------------------------------------------------------------
# Stripe (Payment)
# ---------------------------------------------------------------------------

# Stripe publishable key (safe to expose to the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe secret key — server-side ONLY, never expose to the browser.
STRIPE_SECRET_KEY=sk_test_...
