# ---------------------------------------------------------------------------
# Cartzii Marketplace — LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. `npm run dev` reads .env.local automatically.
#
# THIS FILE IS NOT USED BY ANY DEPLOY. One codebase serves two storefronts, so
# each deployed slot has its own env file, picked by the build script:
#
#   npm run build:qa:ca    -> .env.qa.ca      (qa.cartzii.ca)
#   npm run build:qa:us    -> .env.qa.us      (qa.cartzii.com)
#   npm run build:prod:ca  -> .env.prod.ca    (www.cartzii.ca)
#   npm run build:prod:us  -> .env.prod.us    (www.cartzii.com)
#
# Those four live on the server and are never committed. See their .example
# files for what each one needs.

# ---------------------------------------------------------------------------
# Country
# ---------------------------------------------------------------------------

# Which storefront you are running locally: `ca` or `us`. It picks the
# currency, the locale and the `X-Portal-Locale` header the API scopes every
# read by — so flipping this is how you check the other market without a
# second checkout. Defaults to `ca` when unset.
NEXT_PUBLIC_COUNTRY=ca

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# One API serves both countries; the country travels on each request rather
# than in the hostname.
#   https://qa-api.cartzii.com   (QA — what local dev normally points at)
#   http://localhost:4100        (an API running on this machine)
NEXT_PUBLIC_API_URL=https://qa-api.cartzii.com

# Sent as `x-guest-token` on unauthenticated requests (cart, checkout).
# Must match GUEST_API_TOKEN in the API's env file, or every guest read 401s.
NEXT_PUBLIC_GUEST_API_TOKEN=

# ---------------------------------------------------------------------------
# CDN / Assets
# ---------------------------------------------------------------------------

# Prefix for the bare image filenames the API returns.
NEXT_PUBLIC_IMAGE_CDN_URL=https://qa-api.cartzii.com/assets/upload/productImages

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Publishable key — safe in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key — server-side ONLY. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------

# Address autocomplete at checkout. Optional; checkout falls back to manual entry.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
